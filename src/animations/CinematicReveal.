
"use client";

import {
  motion,
  useReducedMotion,
  type Variants,
} from "framer-motion";
import type { ReactNode } from "react";

import {
  TALA_EASE,
  TALA_TRANSITIONS,
  titleReveal,
  subtitleReveal,
  imageReveal,
  imageZoom,
  staggerContainer,
  staggerItem,
  luxuryButton,
  gentleFloat,
  slowFloat,
  ambientPulse,
} from "./tala-motion";

// ============================================
// TYPES
// ============================================

type BaseProps = {
  children: ReactNode;
  className?: string;
};

type DelayProps = BaseProps & {
  delay?: number;
};

type StaggerProps = BaseProps & {
  stagger?: number;
  delay?: number;
};

// ============================================
// 01 — CINEMATIC HERO
// ============================================

export function CinematicHero({
  children,
  className,
}: BaseProps) {
  const reduced = useReducedMotion();

  return (
    <motion.section
      className={className}
      initial={
        reduced
          ? false
          : {
              opacity: 0,
              scale: 1.025,
            }
      }
      animate={{
        opacity: 1,
        scale: 1,
      }}
      transition={
        reduced
          ? { duration: 0 }
          : {
              duration: 1.4,
              ease: TALA_EASE,
            }
      }
    >
      {children}
    </motion.section>
  );
}

// ============================================
// 02 — EDITORIAL TITLE
// ============================================

export function EditorialTitle({
  children,
  className,
  delay = 0,
}: DelayProps) {
  const reduced = useReducedMotion();

  return (
    <motion.div
      className={className}
      variants={titleReveal}
      initial={reduced ? false : "initial"}
      animate="animate"
      transition={{
        ...TALA_TRANSITIONS.cinematic,
        delay: reduced ? 0 : delay,
      }}
    >
      {children}
    </motion.div>
  );
}

// ============================================
// 03 — EDITORIAL SUBTITLE
// ============================================

export function EditorialSubtitle({
  children,
  className,
