// ============================================
// 14 — PREMIUM DIVIDER
// ============================================

export function PremiumDivider({
  className,
}: {
  className?: string;
}) {
  const reduced = useReducedMotion();

  return (
    <motion.div
      className={className}
      initial={
        reduced
          ? false
          : {
              scaleX: 0,
              opacity: 0,
            }
      }
      whileInView={{
        scaleX: 1,
        opacity: 1,
      }}
      viewport={{
        once: true,
      }}
      transition={{
        duration: reduced ? 0 : 1.2,
        ease: TALA_EASE,
      }}
      style={{
        transformOrigin: "left",
      }}
    />
  );
}
